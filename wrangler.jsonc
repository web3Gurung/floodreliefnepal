{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "floodreliefnepal",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-08-27",

	// Astro's static output. The Worker handles /api/ledger and hands everything
	// else to this binding.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},

	// Holds one key, `ledger`, written by the cron below. Create the namespace
	// with `npx wrangler kv namespace create LEDGER` and paste the id here.
	"kv_namespaces": [
		{
			"binding": "LEDGER",
			"id": "PASTE_KV_NAMESPACE_ID_HERE"
		}
	],

	// Every 60 seconds. Ethereum blocks are 12 seconds and the free Etherscan
	// quota is 100,000 calls a day, so anything faster spends quota for no
	// freshness.
	"triggers": {
		"crons": ["* * * * *"]
	},

	// A cron that fails does so silently. This is how you find out.
	"observability": {
		"enabled": true
	}

	// Secrets are never in this file. Push them with `wrangler secret put`:
	// ETHERSCAN_API_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY.
}
