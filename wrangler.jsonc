{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "floodreliefnepal",
	"main": "./worker/index.ts",

	// Secrets live in the Worker's runtime Variables and Secrets, added in the
	// dashboard. Wrangler treats this file as the source of truth by default and
	// deletes anything it does not find here, which is what wiped the three keys
	// on the deploy of 1 September. This keeps them.
	"keep_vars": true,
	"compatibility_date": "2026-09-01",
	"preview_urls": true,
	"routes": [
		{
			"pattern": "floodreliefnepal.com/*",
			"zone_name": "floodreliefnepal.com"
		}
	],

	// Astro's static output. The Worker answers /api/ledger and hands every
	// other path to this binding.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Multi-page Astro site with src/pages/404.astro. Do not use
		// single-page-application: that would serve index.html for unknown routes.
		"not_found_handling": "404-page"
	},

	// Holds one key, `ledger`, written by the cron below. The id is an
	// identifier, not a credential, so it belongs in the repo.
	"kv_namespaces": [
		{
			"binding": "LEDGER",
			"id": "2881bd179f754978a66ea065b0bd25e5"
		}
	],

	// Every ten minutes, and the number is set by KV writes, not by Etherscan.
	// Etherscan's free quota is 100,000 calls a day and was never the binding
	// constraint; the KV free plan allows 1,000 writes a day, resetting at
	// 00:00 UTC, and a run costs two of them before it writes anything (the
	// `last-run` lock, then `last-ok`). At one tick a minute that is 2,880
	// writes and the namespace stops accepting them before nine in the morning,
	// which is what happened on 2 September: 1,781 writes against a cap of
	// 1,000 while reads sat at 1,431 against a cap of 100,000.
	//
	// 144 ticks a day is 288 writes, and the ledger write is one per run at
	// most however many donations that run finds, so the true ceiling is 432 on
	// a day busy enough that every single tick has something new to store. That
	// is 43% of the cap in the worst case and about 34% on a quiet day. Four
	// minutes was the first fix and it does not survive its own worst case:
	// 360 ticks writing the ledger every time is 1,080.
	//
	// Anything changed here has to move REFRESH_STALE_AFTER_MS and
	// REFRESH_MIN_INTERVAL_MS in worker/index.ts with it, and the cadence in
	// the freshness line on the transparency page. Both of those constants are
	// sized against this interval, and a mismatch quietly hands the writes back
	// to readers and to the outside scheduler.
	"triggers": {
		"crons": ["*/10 * * * *"]
	},

	// A cron that fails does so silently. This is how you find out.
	"observability": {
		"enabled": true
	}

	// Secrets are never in this file. Push them with `wrangler secret put`:
	// ETHERSCAN_API_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY.
}
