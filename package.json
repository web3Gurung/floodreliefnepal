{
  "name": "floodreliefnepal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy",
    "preview:worker": "npm run build && wrangler dev",
    "index:donations": "node --env-file=.env.local scripts/index-donations.ts",
    "index:donations:full": "node --env-file=.env.local scripts/index-donations.ts --full",
    "index:posts": "node scripts/index-posts.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.127.0"
  }
}
