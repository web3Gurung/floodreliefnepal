---
import { routes, site } from '../data/site';
import { copyForPath, langFromPath } from '../data/copy';

interface Props {
	/** Every language the page being rendered exists in. Defaults to the homepage. */
	pageRoutes?: { readonly en: string; readonly ne?: string; readonly zh?: string };
}

const { pageRoutes = routes.home } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const header = copyForPath(Astro.url.pathname).header;
const home = site.routes[lang];

// A page offers only the languages it has. Sending a reader to a different page
// under a language label is worse than not offering that language here.
const languages = header.languages.filter((language) => pageRoutes[language.lang]);

// The money section lives on the homepage, so pages beyond it link back to it.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onHome = path === home.replace(/\/+$/, '') || path === '/';
const give = onHome ? '#give' : `${home}#give`;
---

<header class="hairline">
	<nav class="wrap flex min-h-16 flex-wrap items-center justify-between gap-x-4 gap-y-3 py-3">
		<a class="inline-flex min-h-11 items-center text-[0.95rem] font-medium tracking-tight no-underline" href={home}
			>{header.brand}</a
		>
		<div class="flex items-center gap-2 sm:gap-4">
			<ul class="flex items-center text-[0.9rem]">
				{
					languages.map((language) => (
						<li>
							<a
								class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 underline-offset-4 hover:underline aria-[current=true]:font-medium aria-[current=true]:underline"
								href={pageRoutes[language.lang]}
								hreflang={language.lang}
								lang={language.lang}
								aria-current={language.lang === lang ? 'true' : undefined}
							>
								{language.label}
							</a>
						</li>
					))
				}
			</ul>
			<a class="btn-outline" href={give}>{header.give}</a>
		</div>
	</nav>
</header>
