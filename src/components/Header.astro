---
import { routes } from '../data/site';
import { copyForPath, langFromPath } from '../data/copy';

interface Props {
	/** Both languages of the page being rendered. Defaults to the homepage. */
	pageRoutes?: { readonly en: string; readonly ne: string };
}

const { pageRoutes = routes.home } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const header = copyForPath(Astro.url.pathname).header;
const home = lang === 'ne' ? routes.home.ne : routes.home.en;

// The money section lives on the homepage, so pages beyond it link back to it.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onHome = path === home.replace(/\/+$/, '') || path === '/';
const give = onHome ? '#give' : `${home}#give`;
---

<header class="hairline">
	<nav class="wrap flex min-h-16 flex-wrap items-center justify-between gap-x-4 gap-y-3 py-3">
		<a class="text-[0.95rem] font-medium tracking-tight no-underline" href={home}>{header.brand}</a>
		<div class="flex items-center gap-4">
			<ul class="flex items-center gap-3 text-[0.9rem]">
				{
					header.languages.map((language) => (
						<li>
							<a
								class="underline-offset-4 hover:underline aria-[current=true]:font-medium aria-[current=true]:underline"
								href={language.lang === 'ne' ? pageRoutes.ne : pageRoutes.en}
								hreflang={language.lang}
								lang={language.lang}
								aria-current={language.lang === lang ? 'true' : undefined}
							>
								{language.label}
							</a>
						</li>
					))
				}
			</ul>
			<a class="btn-outline" href={give}>{header.give}</a>
		</div>
	</nav>
</header>
