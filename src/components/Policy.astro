---
import { copyForPath } from '../data/copy';

const policy = copyForPath(Astro.url.pathname).policy;
---

<section class="chapter hairline" id="policy">
	<div class="wrap split">
		<div>
			<h2 class="display">{policy.heading}</h2>
			<p class="lede">{policy.lede}</p>
		</div>
		<div class="max-w-[38rem] space-y-5 text-muted">
			{policy.body.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</div>
</section>
