---
import { copyForPath, splitBy } from '../data/copy';

const policy = copyForPath(Astro.url.pathname).policy;
const highlights = [
	'Private groups are not allowed to collect money or goods on their own.',
	'निजी समूहले आफ्नै तवरबाट पैसा वा सामान उठाउन पाउँदैनन्।',
] as const;
---

<section class="chapter hairline" id="policy">
	<div class="wrap split">
		<div>
			<h2 class="quiet-title">{policy.heading}</h2>
			<p class="lede">{policy.lede}</p>
		</div>
		<div class="max-w-[38rem] space-y-5 text-muted">
			{
				policy.body.map((paragraph) => (
					<p>
						{
							splitBy(paragraph, highlights).map((chunk) =>
								chunk.hit ? <mark class="mark-brush">{chunk.text}</mark> : chunk.text,
							)
						}
					</p>
				))
			}
		</div>
	</div>
</section>
