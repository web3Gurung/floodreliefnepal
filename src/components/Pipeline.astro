---
/**
 * Six steps from a donor's wallet to the fund's account.
 *
 * Two rows of three, with a labelled break after the public record. The split
 * this section exists to show lives in the layout, not only in a badge.
 */
import { copyForPath } from '../data/copy';

const copy = copyForPath(Astro.url.pathname).transparency.pipeline;

const rows = [
	{ start: 1, steps: copy.steps.slice(0, 3) },
	{ start: 4, steps: copy.steps.slice(3) },
];
---

<section class="chapter hairline" id="pipeline">
	<div class="wrap">
		<h2 class="chapter-title max-w-none">{copy.heading}</h2>
		<p class="lede">{copy.lede}</p>

		<div class="pipeline">
			{
				rows.map((row, rowIndex) => (
					<>
						{rowIndex === 1 && (
							<p class="pipeline-break">
								<span>{copy.breakLabel}</span>
							</p>
						)}
						<ol class="pipeline-row" start={row.start}>
							{row.steps.map((step, index) => (
								<>
									<li class="pipeline-step card">
										<div class="flex items-baseline gap-3">
											<span class="pipeline-num">{row.start + index}</span>
											<h3 class="pipeline-title">{step.title}</h3>
										</div>
										{!step.live && <p class="eyebrow mt-4">{copy.notLiveLabel}</p>}
										<p class="mt-4">{step.what}</p>
										<p class="mt-3 text-[0.95rem] text-muted">{step.proof}</p>
									</li>
									{index < row.steps.length - 1 && (
										<li class="pipeline-arrow" aria-hidden="true">
											<svg
												width="20"
												height="20"
												viewBox="0 0 20 20"
												fill="none"
												xmlns="http://www.w3.org/2000/svg"
											>
												<path
													d="M4 10h12M12 6l4 4-4 4"
													stroke="currentColor"
													stroke-width="1.5"
													stroke-linecap="round"
													stroke-linejoin="round"
												></path>
											</svg>
										</li>
									)}
								</>
							))}
						</ol>
					</>
				))
			}
		</div>

		<p class="lede mt-10 mb-0 max-w-[46rem]">{copy.closing}</p>
	</div>
</section>

<style>
	.pipeline {
		margin-top: 2.5rem;
	}

	.pipeline-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.75rem;
		align-items: stretch;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.pipeline-step {
		height: 100%;
		padding: 1.75rem;
	}

	.pipeline-num {
		font-size: 1.65rem;
		line-height: 1;
		font-weight: 500;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
	}

	.pipeline-title {
		font-size: 1.25rem;
		line-height: 1.2;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	:global(html.lang-np) .pipeline-num,
	:global(html.lang-np) .pipeline-title {
		letter-spacing: normal;
	}

	.pipeline-arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		line-height: 0;
	}

	.pipeline-arrow svg {
		transform: rotate(90deg);
	}

	.pipeline-break {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 2.25rem 0;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.pipeline-break::before,
	.pipeline-break::after {
		content: '';
		flex: 1 1 auto;
		height: 1px;
		background: var(--line);
	}

	:global(html.lang-np) .pipeline-break {
		font-size: 0.95rem;
		letter-spacing: normal;
		text-transform: none;
	}

	@media (min-width: 64rem) {
		.pipeline-row {
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
			gap: 1.25rem 0.35rem;
		}

		.pipeline-step {
			padding: 2rem;
		}

		.pipeline-arrow {
			min-width: 2.25rem;
		}

		.pipeline-arrow svg {
			transform: none;
		}
	}
</style>
