---
import { copyForPath, splitBy } from '../data/copy';

const verify = copyForPath(Astro.url.pathname).verify;
const domains = ['pmdrf.nchl.com.np', 'pmrelieffund.himalayanbank.com'] as const;
---

<section class="chapter-peak hairline" id="verify">
	<div class="wrap">
		<div class="center-block">
			<h2 class="chapter-title max-w-none">{verify.heading}</h2>
			<p class="lede">{verify.lede}</p>
		</div>
		<ul class="mx-auto mt-2 max-w-xl divide-y divide-line border-t border-line text-left">
			{
				verify.checks.map((check) => (
					<li class="py-5">
						<h3 class="mb-1 font-medium">{check.title}</h3>
						<p class="text-muted">
							{
								splitBy(check.body, domains).map((chunk) =>
									chunk.hit ? (
										<strong class="font-semibold text-ink">{chunk.text}</strong>
									) : (
										chunk.text
									),
								)
							}
						</p>
					</li>
				))
			}
		</ul>
		<p class="mx-auto mt-8 max-w-xl text-left">
			<a class="underline" href={verify.link.href} target="_blank" rel="noopener noreferrer">{verify.link.label}</a>
		</p>
	</div>
</section>
