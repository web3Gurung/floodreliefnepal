---
import { hubs, supplies } from '../data/site';
---

<section class="chapter hairline" id="supplies">
	<div class="wrap">
		<div class="center-block">
			<h2 class="display max-w-[14ch]">{supplies.heading}</h2>
			<p class="lede">{supplies.lede}</p>
		</div>
		<ul class="mx-auto mt-12 max-w-xl divide-y divide-line text-left">
			{
				hubs.map((hub) => (
					<li class="py-6 first:pt-0">
						<h3 class="mb-1 font-medium">{hub.title}</h3>
						<p class="text-muted">{hub.place}</p>
						<p class="mt-1 text-muted">
							{hub.who},{' '}
							<a class="whitespace-nowrap underline" href={`tel:${hub.phone.replaceAll(' ', '')}`}>
								{hub.phone}
							</a>
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
