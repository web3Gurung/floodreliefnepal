---
import { Picture } from 'astro:assets';
import hero from '../assets/hero.jpg';
---

<section class="relative isolate">
	<div class="wrap py-16 md:py-20">
		<div class="center-block">
			<p class="mb-4 text-sm text-muted">Independent public guide</p>
			<h1 class="display max-w-[12ch]">Flood Relief Nepal</h1>
			<p class="lede">
				Where to give, where to drop supplies, and how to skip fake QR codes. Not a government site.
			</p>
			<div class="flex flex-wrap items-center justify-center gap-4">
				<a class="btn" href="#give">See how to help</a>
				<a class="text-muted underline-offset-4 hover:underline" href="#policy">One-door system</a>
			</div>
		</div>
		<figure class="mx-auto mt-14 max-w-5xl">
			<Picture
				src={hero}
				formats={['avif', 'webp']}
				fallbackFormat="jpg"
				alt="Snow peaks and a hillside stupa in the Nepal Himalaya"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 64rem) 64rem, calc(100vw - 2.5rem)"
				quality="mid"
				class="aspect-[16/9] h-auto w-full object-cover"
				pictureAttributes={{ class: 'block w-full' }}
				priority
			/>
			<figcaption class="quiet mt-3 text-center">Nepal Himalaya</figcaption>
		</figure>
	</div>
</section>
