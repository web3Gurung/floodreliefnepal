---
import { Picture } from 'astro:assets';
import heroPhoto from '../assets/hero.jpg';
import { copyForPath } from '../data/copy';

const hero = copyForPath(Astro.url.pathname).hero;
---

<section class="relative isolate">
	<div class="wrap py-16 md:py-20">
		<div class="center-block">
			<p class="mb-4 text-sm text-muted">{hero.eyebrow}</p>
			<h1 class="display max-w-[12ch]">{hero.title}</h1>
			<p class="lede">{hero.lede}</p>
			<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
				<a class="btn" href={hero.primary.href}>{hero.primary.label}</a>
				{
					hero.links.map((link) => (
						<a class="text-muted underline-offset-4 hover:underline" href={link.href}>
							{link.label}
						</a>
					))
				}
			</div>
		</div>
		<figure class="mx-auto mt-14 max-w-5xl">
			<Picture
				src={heroPhoto}
				formats={['avif', 'webp']}
				fallbackFormat="jpg"
				alt={hero.photoAlt}
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 64rem) 64rem, calc(100vw - 2.5rem)"
				quality="mid"
				class="photo aspect-[16/9] h-auto w-full object-cover"
				pictureAttributes={{ class: 'block w-full' }}
				priority
			/>
			<figcaption class="quiet mt-3 text-center">{hero.photoCaption}</figcaption>
		</figure>
	</div>
</section>
