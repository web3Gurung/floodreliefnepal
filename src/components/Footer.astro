---
import { site } from '../data/site';
import { copyForPath } from '../data/copy';

const footer = copyForPath(Astro.url.pathname).footer;
const recent = footer.changelog.slice(0, 3);
---

<footer class="hairline py-12 text-[0.95rem] text-muted">
	<div class="wrap mx-auto max-w-xl">
		<p class="mb-1">{footer.lastChecked} {footer.lastCheckedDate}</p>
		{
			recent.length > 0 && (
				<ul class="mb-4 max-w-sm space-y-1.5 text-[0.9rem]">
					{recent.map((entry) => (
						<li>
							<span class="whitespace-nowrap text-ink">{entry.date}</span>, {entry.note}
						</li>
					))}
				</ul>
			)
		}
		<p class="mb-4">{footer.independent}</p>
		<p>
			{footer.contribute.before}<a class="underline" href={site.github} target="_blank" rel="noopener noreferrer"
				>{footer.contribute.linkLabel}</a
			>{footer.contribute.after}
		</p>
		<p class="mt-6 text-[0.9rem]">
			{footer.madeBy.before}<a class="underline" href={site.makers.ronak} target="_blank" rel="noopener noreferrer"
				>{footer.madeBy.ronakLabel}</a
			>{footer.madeBy.middle}<a class="underline" href={site.makers.ayushman} target="_blank" rel="noopener noreferrer"
				>{footer.madeBy.ayushmanLabel}</a
			>{footer.madeBy.beforeYanbo}<a class="underline" href={site.makers.yanbo} target="_blank" rel="noopener noreferrer"
				>{footer.madeBy.yanboLabel}</a
			>{footer.madeBy.after}
		</p>
	</div>
</footer>
