---
import { site } from '../data/site';
---

<section class="chapter" id="give">
	<div class="wrap split">
		<div>
			<h2 class="display">If you want to send money</h2>
			<p class="lede">
				One option is the government's card portal. There is no cap. You can send any amount. Bank-transfer details will land here in a later update.
			</p>
		</div>
		<div class="max-w-xl">
			<p class="mb-4">The portal takes cards. It sits on the government's own domain, not this one.</p>
			<a class="btn" href={site.official.pmdrf} rel="noopener noreferrer">Open pmdrf.nchl.com.np</a>
			<p class="quiet">Leaves this site.</p>
		</div>
	</div>
</section>
