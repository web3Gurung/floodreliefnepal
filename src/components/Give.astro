---
import { site } from '../data/site';
---

<section class="chapter" id="give">
	<div class="wrap split">
		<div>
			<h2 class="display">If you want to send money</h2>
			<p class="lede">
				Use the government's payment page. There is no cap. You can send any amount.
			</p>
		</div>
		<div class="max-w-xl">
			<p>The portal takes cards. It sits on the government's own domain.</p>
			<p class="mt-4">
				<a class="underline" href={site.official.pmdrf} rel="noopener noreferrer">pmdrf.nchl.com.np</a>
			</p>
			<p class="quiet">Bank-transfer details will land here in a later update.</p>
		</div>
	</div>
</section>
