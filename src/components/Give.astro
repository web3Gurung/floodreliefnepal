---
import { copyForPath } from '../data/copy';

const copy = copyForPath(Astro.url.pathname);
const give = copy.give;
const raised = give.raised;
---

<section class="chapter-peak hairline" id="give">
	<div class="wrap">
		<div class="center-block">
			<h2 class="chapter-title max-w-none">{give.heading}</h2>
			<p class="lede">{give.lede}</p>
			{
				raised && (
					<p class="mb-10">
						<span class="raised">
							{raised.amount} <span class="raised-usd">({raised.amountUsd})</span>
						</span>
						<span class="mt-2 block text-muted">
							{raised.note}
							{copy.ui.sentenceEnd} {copy.ui.asOf} {raised.asOf}
							{copy.ui.sentenceEnd}{' '}
							<a class="underline" href={raised.source} rel="noopener noreferrer">
								{give.raisedReportLabel}
							</a>
						</span>
					</p>
				)
			}
		</div>

		<div class="grid gap-6 md:grid-cols-2">
			{
				give.cards.map((card) => (
					<article class="card">
						<p class="eyebrow">{card.eyebrow}</p>
						<h3 class="card-title mt-3">{card.title}</h3>
						<p class="mt-4 text-muted">{card.body}</p>
						<div class="mt-auto pt-8">
							<a class="btn btn-stack w-full" href={card.action.href} rel="noopener noreferrer">
								<span>{card.action.label}</span>
								<span class="btn-sub">{card.action.sub}</span>
							</a>
							<p class="quiet">{card.note}</p>
						</div>
					</article>
				))
			}
		</div>

		<div class="mx-auto mt-12 max-w-[42rem] space-y-5 text-muted">
			<p>
				{give.alternate.text}{' '}
				<a class="break-words underline" href={give.alternate.href} rel="noopener noreferrer">
					{give.alternate.linkLabel}
				</a>
			</p>
			<p>{give.closing}</p>
		</div>
	</div>
</section>
