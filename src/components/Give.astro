---
import { copyForPath, splitBy } from '../data/copy';

const copy = copyForPath(Astro.url.pathname);
const give = copy.give;
const raised = give.raised;
const brands = ['KAST', 'Solflare', 'RedotPay'] as const;
const usdPhrases = ['quotes in USD', 'अमेरिकी डलरमा'] as const;
---

<section class="chapter-peak hairline" id="give">
	<div class="wrap">
		<div class="center-block">
			<h2 class="chapter-title max-w-none">{give.heading}</h2>
			<p class="lede">{give.lede}</p>
			{
				raised && (
					<p class="mb-10">
						<span class="raised">
							{raised.amount} <span class="raised-usd">({raised.amountUsd})</span>
						</span>
						<span class="mt-2 block text-muted">
							{raised.note}
							{copy.ui.sentenceEnd} {copy.ui.asOf} {raised.asOf}
							{copy.ui.sentenceEnd}{' '}
							<a class="underline" href={raised.source} target="_blank" rel="noopener noreferrer">
								{give.raisedReportLabel}
							</a>
						</span>
					</p>
				)
			}
		</div>

		<div class="grid gap-6 md:grid-cols-2">
			{
				give.cards.map((card) => (
					<article class="card">
						<p class="eyebrow">{card.eyebrow}</p>
						<h3 class="card-title mt-3">{card.title}</h3>
						<p class="mt-4 text-muted">
							{
								splitBy(card.body, brands).map((chunk) =>
									chunk.hit ? <mark class="mark-brush">{chunk.text}</mark> : chunk.text,
								)
							}
						</p>
						<div class="mt-auto pt-8">
							<a class="btn btn-stack w-full" href={card.action.href} target="_blank" rel="noopener noreferrer">
								<span>{card.action.label}</span>
								<span class="btn-sub">{card.action.sub}</span>
							</a>
							<p class="quiet">{card.note}</p>
						</div>
					</article>
				))
			}
		</div>

		<aside class="callout mt-6">
			<p class="text-muted">
				{
					splitBy(give.alternate.text, usdPhrases).map((chunk) =>
						chunk.hit ? <mark class="mark-brush">{chunk.text}</mark> : chunk.text,
					)
				}
			</p>
			<a
				class="btn-outline max-w-full shrink-0 self-start break-all"
				href={give.alternate.href}
				target="_blank"
				rel="noopener noreferrer"
			>
				{give.alternate.linkLabel}
			</a>
		</aside>
		<p class="mx-auto mt-8 max-w-[42rem] text-muted">{give.closing}</p>
	</div>
</section>
