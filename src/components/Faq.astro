---
import { copyForPath } from '../data/copy';

const faq = copyForPath(Astro.url.pathname).faq;
---

<section class="chapter hairline" id="questions">
	<div class="wrap">
		<div class="center-block">
			<h2 class="display max-w-none">{faq.heading}</h2>
		</div>
		<div class="mx-auto mt-10 max-w-xl text-left">
			{
				faq.items.map((item) => (
					<details class="group border-t border-line py-5 last:border-b">
						<summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 font-medium [&::-webkit-details-marker]:hidden">
							{item.q}
							<span class="text-muted group-open:hidden" aria-hidden="true">
								+
							</span>
							<span class="hidden text-muted group-open:inline" aria-hidden="true">
								-
							</span>
						</summary>
						<p class="mt-3 max-w-[65ch] text-muted">{item.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
