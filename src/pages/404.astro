---
import Layout from '../layouts/Layout.astro';
import { en } from '../data/site';

const notFound = en.notFound;
---

<Layout title={notFound.title} description={notFound.description} lang="en" faq={false}>
	<section class="wrap min-h-[70dvh] py-24 text-center">
		<h1 class="display mx-auto">{notFound.heading}</h1>
		<p class="lede mx-auto">
			{notFound.before}<a class="underline" href="/">{notFound.linkLabel}</a>{notFound.after}
		</p>
	</section>
</Layout>
